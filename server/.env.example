# Скопируй в корневой .env (на уровень выше) и заполни значения.
DATABASE_URL=postgresql://calorie:calorie@localhost:5432/calorieyka
DB_POOL_MAX=20                      # размер пула соединений Postgres
JWT_SECRET=change_me
INITDATA_MAX_AGE_SEC=86400          # макс. возраст Telegram initData (сек), защита от replay; по умолч. сутки
OPENAI_API_KEY=sk-...
# OPENAI_MODEL — общий фолбэк. Для точности порций фото и текст используют РАЗНЫЕ модели:
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4.1        # анализ фото — ТОЛЬКО резерв, если Gemini недоступен
OPENAI_TEXT_MODEL=gpt-4.1-mini     # анализ текстового описания еды
# Gemini — основной (и бесплатный) анализ фото. Ключ: https://aistudio.google.com/apikey
# Пусто = фото считает OpenAI, как раньше. Квота 500 фото/сутки на КАЖДУЮ модель из списка.
GEMINI_API_KEY=
GEMINI_VISION_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
OPENAI_ADMIN_KEY=                  # sk-admin-... — реальные расходы OpenAI (Costs API) в админке; пусто = оценка по токенам
USD_RUB_FALLBACK=100               # запасной курс $, если ЦБ РФ недоступен
# ЮKassa: shopId — Настройки→Магазин; секретный ключ — Интеграция→Ключи API (выпустить+активировать).
# PAYMENTS_MODE=live — боевая оплата; mock — локальный тест. Пустые ключи => всегда mock.
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
PAYMENTS_MODE=live
YUKASSA_RECURRING=false             # true → save_payment_method (автопродление); магазин без рекуррентов отдаёт 403
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SUPPORT_BOT_TOKEN=                  # токен бота техподдержки (тот же, что в support/.env) — ответы из веб-админки и фото тикетов
# Обязательная подписка на канал (бот должен быть его админом). Пусто = проверка отключена.
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=
ADMIN_TELEGRAM_IDS=5268728838,1372419250
# Авто-бэкап БД (cron 00:00 МСК шлёт дамп админам в Telegram).
# Если pg_dump не в PATH (Windows) — укажи полный путь к нему:
# PG_DUMP=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
PG_DUMP=

# Админ-панель (admin/) — отдельный защищённый вход
ADMIN_JWT_SECRET=change_me_admin_secret
ADMIN_BOOTSTRAP_PASSWORD=change_me_strong_password   # стартовый пароль для ADMIN_TELEGRAM_IDS, ставится при npm run migrate
ADMIN_IP_ALLOWLIST=                                   # необязательный белый список IP (через запятую)
ADMIN_MAX_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15
SERVER_URL=http://localhost:4000                      # базовый URL бэкенда (трекинг кликов рассылок, фото)

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CLIENT_URL=http://localhost:5173
# Цены берутся из app_settings (раздел «Настройки» админки). Эти значения — fallback.
SUB_PRICE_BASIC=349
SUB_PRICE_TRAINER=1799
TRIAL_DAYS=3
TRIAL_DAILY_PHOTOS=10
TRAINER_MAX_CLIENTS=20             # лимит клиентов у тренера (fallback; основное — в app_settings)
