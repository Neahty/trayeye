{
  "name": "trayeye-server",
  "version": "0.1.0",
  "description": "TrayEye - API кабинетов директора школы и комбината питания",
  "main": "src/index.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed-cli.js",
    "link": "node src/db/link-cli.js",
    "demo-camera": "node src/db/demo-camera-cli.js",
    "bot": "node src/bot/index.js",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "https-proxy-agent": "^7.0.6",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
