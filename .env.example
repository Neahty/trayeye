# ─── Bytwise — пример корневого .env ───
# Скопируй в .env и заполни реальными значениями.
# Реальный .env в git НЕ коммитится (см. .gitignore).

# База данных (нативный PostgreSQL на сервере)
DATABASE_URL=postgresql://calorie:calorie@localhost:5432/calorieyka

# Секреты
JWT_SECRET=
ADMIN_JWT_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
OPENAI_TEXT_MODEL=
OPENAI_ADMIN_KEY=

# ЮKassa
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
PAYMENTS_MODE=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SUPPORT_BOT_TOKEN=
INITDATA_MAX_AGE_SEC=
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=

# Админ
ADMIN_TELEGRAM_IDS=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_IP_ALLOWLIST=

# URLs / окружение
SERVER_URL=https://shekspireteam.ru
CLIENT_URL=https://shekspireteam.ru
CORS_ORIGIN=https://shekspireteam.ru
PORT=4000
NODE_ENV=production

# Тарифы / триал
PRICE_BASIC=
PRICE_TRAINER=
TRIAL_DAYS=
TRIAL_DAILY_PHOTOS=
