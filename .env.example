# ─── Bytwise - пример корневого .env ───
# Скопируй в .env и заполни реальными значениями.
# Реальный .env в git НЕ коммитится (см. .gitignore).

# База данных (нативный PostgreSQL на сервере)
DATABASE_URL=postgresql://calorie:calorie@localhost:5432/calorieyka

# Секреты
JWT_SECRET=
ADMIN_JWT_SECRET=

# OpenAI - платная страховка. Используется, только когда бесплатный Gemini недоступен
# или исчерпал суточную квоту.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
OPENAI_TEXT_MODEL=
OPENAI_ADMIN_KEY=

# Gemini - ОСНОВНОЙ распознаватель еды, бесплатный тир. ЗАПОЛНЯТЬ ОБЯЗАТЕЛЬНО.
# Без GEMINI_API_KEY цепочка провайдеров молча вырождается в один платный OpenAI:
# ошибки не будет, всё продолжит работать - просто каждый скан начнёт стоить около цента,
# и при тысяче сканов в сутки это ~$300 в месяц. Остальные переменные опциональны,
# значения ниже - дефолты из кода (server/src/services/openai.js).
GEMINI_API_KEY=
GEMINI_VISION_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_TEXT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Суточный лимит запросов бесплатного тира НА КАЖДУЮ модель. Сверять с дашбордом AI Studio:
# цифра влияет только на строку «Квота Gemini» в логах канала, реальное переключение
# на OpenAI происходит по фактическому ответу 429.
GEMINI_DAILY_RPD=500
# Пояс, по которому Google обнуляет суточную квоту (тихоокеанское время), а не наш.
GEMINI_QUOTA_TZ=America/Los_Angeles

# ЮKassa
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
PAYMENTS_MODE=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SUPPORT_BOT_TOKEN=
INITDATA_MAX_AGE_SEC=
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=

# Админ
ADMIN_TELEGRAM_IDS=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_IP_ALLOWLIST=

# URLs / окружение
SERVER_URL=https://shekspireteam.ru
CLIENT_URL=https://shekspireteam.ru
CORS_ORIGIN=https://shekspireteam.ru
PORT=4000
NODE_ENV=production

# Тарифы / триал
PRICE_BASIC=
PRICE_TRAINER=
TRIAL_DAYS=
TRIAL_DAILY_PHOTOS=
