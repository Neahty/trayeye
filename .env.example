# TrayEye: пример корневого .env. Скопируй в .env и заполни.
# Реальный .env в git не коммитится.

# PostgreSQL
DATABASE_URL=postgresql://trayeye:CHANGE_ME@localhost:5432/trayeye
# База для тестов API (npm test в server/). Пусто - тесты API пропускаются.
TEST_DATABASE_URL=postgresql://trayeye:CHANGE_ME@localhost:5432/trayeye_test
DB_POOL_MAX=10

# Подпись сессий. В production обязателен: openssl rand -hex 32
JWT_SECRET=

PORT=4100
NODE_ENV=development
# Пояс школы: по нему считается «сегодня».
APP_TZ=Europe/Moscow
# Зафиксировать «сегодня» для демо (YYYY-MM-DD). Пусто - реальная дата.
APP_TODAY=
# Адрес, от которого строятся личные ссылки входа: PUBLIC_URL/l/<токен>.
PUBLIC_URL=http://localhost:5173
# Разрешённые origin для CORS через запятую. Пусто - фронт и API на одном домене.
CORS_ORIGIN=
# Куда сохранять фото подносов (по умолчанию uploads/ в корне репозитория).
UPLOADS_DIR=

# Распознавание подносов: сначала бесплатный Gemini, при сбое - OpenAI.
# Без обоих ключей загрузка фото подноса отвечает ai_not_configured.
GEMINI_API_KEY=
GEMINI_VISION_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
AI_CALL_TIMEOUT_MS=30000
# Gemini и OpenAI не пускают российские IP: на РФ-сервере - прокси в Лондоне по туннелю.
AI_PROXY_URL=
# Камера: сколько подносов с остатками отправлять в ИИ одним запросом (меньше запросов - меньше расход лимита).
CAMERA_AI_BATCH=8
# Telegram-бот: токен от @BotFather и имя бота без @ (для ссылки t.me/<имя>?start=<код> в QR)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TrayEye_bot
