[Unit]
Description=Bytwise API + основной Telegram-бот
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=bytwise
Group=bytwise
WorkingDirectory=/opt/bytwise/server
# .env приложение подгружает само из ../../.env (корень репозитория)
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
# Логи смотреть: journalctl -u bytwise-api -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
